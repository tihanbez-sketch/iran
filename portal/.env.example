# ---------------------------------------------------------------------------
# PFL Super Lead Portal — Phase 1 environment
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Claude API — powers the personalised quiz insights.
# If unset, the portal falls back to pre-approved template insights and keeps working.
ANTHROPIC_API_KEY=

# Supabase project (Project Settings -> API).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional but RECOMMENDED for production.
# Writes happen only from server-side API routes, so a service-role key never
# reaches the browser. With it set, the "anon insert" RLS policies in
# supabase/migrations/0002_rls.sql can be dropped entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for absolute links in the report.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
