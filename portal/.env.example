# ---------------------------------------------------------------------------
# PFL Super Lead Portal — Phase 1 environment
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Claude API — powers the personalised quiz insights.
# If unset, the portal falls back to pre-approved template insights and keeps working.
ANTHROPIC_API_KEY=

# Supabase project (Project Settings -> API).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# REQUIRED once migration 0005 is applied (it revokes anon writes) — all web
# funnel writes and the book import run through it, server-side only. It never
# reaches the browser. Set it BEFORE applying 0005; see CALLCENTRE.md.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for absolute links in the report.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
